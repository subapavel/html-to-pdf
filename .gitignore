# Rust
/target/
**/*.rs.bk

# Rendered output is regenerated by scripts (out/). Two kinds of render ARE committed:
#   fixtures/**/reference/  — Chrome reference (the oracle)
#   fixtures/**/golden/     — our own accepted output
/out/
*.pdf
*.png
!fixtures/**/reference/*.pdf
!fixtures/**/reference/*.png
!fixtures/**/golden/*.pdf
!fixtures/**/golden/*.png
!fixtures/invoices/*/*.png
!docs/**/*.png

# Fonts are fetched by scripts/fetch-fonts.sh, not committed
/fixtures/fonts/*.ttf
/fixtures/fonts/*.otf
/fixtures/fonts/*.woff2

# Node (Tailwind CLI)
node_modules/
package-lock.json

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Claude Code local state
.claude/settings.local.json

# Python
__pycache__/
