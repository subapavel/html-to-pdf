# Fonts are fetched by scripts/fetch-fonts.sh, not committed
/fixtures/fonts/*.ttf
/fixtures/fonts/*.otf
/fixtures/fonts/*.woff2

# Node (Tailwind CLI)
node_modules/
package-lock.json

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Claude Code local state
.claude/settings.local.json
